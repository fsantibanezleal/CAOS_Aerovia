{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerovia.fasl-work.com/schemas/network-v1.json",
  "title": "Aerovia ventilation network v1",
  "type": "object",
  "required": ["schema", "id", "name", "description", "provenance", "nodes", "edges"],
  "properties": {
    "schema": {"const": "aerovia.network/v1"},
    "id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/localized"},
    "description": {"$ref": "#/$defs/localized"},
    "provenance": {"type": "object", "required": ["kind", "source", "license"], "properties": {"kind": {"enum": ["authored", "imported"]}, "source": {"type": "string", "minLength": 1, "maxLength": 4000}, "license": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "nodes": {"type": "array", "minItems": 2, "maxItems": 120, "items": {"type": "object", "required": ["id", "x", "y", "z"], "properties": {"id": {"$ref": "#/$defs/id"}, "x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"}, "z": {"$ref": "#/$defs/coordinate"}, "boundary": {"$ref": "#/$defs/coordinate"}}}},
    "edges": {"type": "array", "minItems": 1, "maxItems": 240, "items": {"type": "object", "required": ["id", "from", "to", "name", "kind", "area", "resistance", "target", "level"], "properties": {"id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/localized"}, "kind": {"enum": ["intake", "return", "working", "crosscut", "fan"]}, "area": {"type": "number", "minimum": 0.1, "maximum": 1000}, "resistance": {"type": "number", "minimum": 0.000001, "maximum": 1000000}, "target": {"anyOf": [{"const": 0}, {"type": "number", "minimum": 0.000001, "maximum": 10000}]}, "level": {"type": "number", "minimum": -100, "maximum": 100}, "fan": {"type": "object", "required": ["pressure", "coefficient", "efficiency"], "properties": {"pressure": {"type": "number", "minimum": 0, "maximum": 100000}, "coefficient": {"type": "number", "minimum": 0, "maximum": 10000}, "efficiency": {"type": "number", "minimum": 0.05, "maximum": 1}}}}, "allOf": [{"if": {"properties": {"kind": {"const": "fan"}}}, "then": {"required": ["fan"]}, "else": {"not": {"required": ["fan"]}}}]}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"},
    "coordinate": {"type": "number", "minimum": -1000000, "maximum": 1000000},
    "localized": {"type": "object", "required": ["en", "es"], "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 4000}, "es": {"type": "string", "minLength": 1, "maxLength": 4000}}}
  }
}
