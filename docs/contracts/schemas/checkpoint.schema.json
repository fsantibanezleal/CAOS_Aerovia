{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "title": "Aerovia model checkpoint",
  "description": "Contract checkpoint 1.0.0: the dict torch.save writes for a trained model (data/models/*/*.pt: data-pipeline/aerovia_pipeline/surrogate_train.py save_checkpoint, read by load_checkpoint), described as tests/contracts/pt_reader.py reads it without torch: the metadata as is and each stateDict entry as its shape and element type. edges equals the branch count of the calibrated topology; the registry entry of the file names it. The resumable training state (optimizer, history) is never committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "methodId",
    "caseIds",
    "edges",
    "architecture",
    "seed",
    "epoch",
    "datasetHashes",
    "runtime",
    "stateDict",
    "validationLoss"
  ],
  "properties": {
    "schema": {
      "const": "aerovia.checkpoint/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "methodId": {
      "enum": [
        "topology-mlp",
        "graph-surrogate"
      ]
    },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "edges": {
      "type": "integer",
      "minimum": 1
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "steps"
      ],
      "properties": {
        "hidden": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "datasetHashes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minProperties": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "hardware",
        "torch"
      ],
      "properties": {
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "torch": {
          "type": "string",
          "minLength": 1
        },
        "cuda": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": "string"
        },
        "tf32": {
          "type": "boolean"
        },
        "threads": {
          "type": "integer",
          "minimum": 0
        },
        "deterministicAlgorithms": {
          "type": "boolean"
        }
      }
    },
    "stateDict": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/tensor"
      }
    },
    "validationLoss": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
      "description": "A portable identifier of 1 to 80 characters (the pipeline limit; the browser reader accepts up to 100)."
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "dtype"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A weight tensor as the torch-free reader reports it: its shape and element type, never its values."
    }
  }
}
