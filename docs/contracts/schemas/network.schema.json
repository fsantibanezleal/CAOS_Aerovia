{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network.schema.json",
  "title": "Aerovia ventilation networks",
  "description": "Contract network 1.0.0 (ADR-0080): the authored case library data/cases.json, a list of aerovia.network/v1 objects written by data-pipeline/aerovia_pipeline/cli.py (create) and validated by aerovia_pipeline/model.py validate_network and frontend/src/engine/validation.ts. $defs.network is one network (the browser, the project file and the worker requests carry one); $defs.options is the operating point every solve takes.",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "$ref": "#/$defs/network"
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
      "description": "A portable identifier of 1 to 80 characters (the pipeline limit; the browser reader accepts up to 100)."
    },
    "coordinate": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000,
      "description": "Metres, or Pa for a boundary pressure."
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "description": "A reader-facing string, bilingual at the source. The limit is the stricter of the pipeline (4000) and the browser reader (300 for names)."
    },
    "target": {
      "anyOf": [
        {
          "const": 0
        },
        {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 10000
        }
      ],
      "description": "The airflow target of a branch in m3/s; 0 disables it."
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "z"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "boundary": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "fan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure",
        "coefficient",
        "efficiency"
      ],
      "properties": {
        "pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "coefficient": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "efficiency": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "name",
        "kind",
        "area",
        "resistance",
        "target",
        "level"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "kind": {
          "enum": [
            "intake",
            "return",
            "working",
            "crosscut",
            "fan"
          ]
        },
        "area": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000
        },
        "resistance": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000.0
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "level": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "fan": {
          "$ref": "#/$defs/fan"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fan"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "fan"
            ]
          },
          "else": {
            "not": {
              "required": [
                "fan"
              ]
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "license"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authored",
            "imported"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "edgeOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "resistance": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000.0
        },
        "area": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "description": "What an operator changes on one branch; a closed branch carries no flow."
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speed",
        "resistanceScale",
        "overrides"
      ],
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "description": "Common fan speed as a fraction of nominal."
        },
        "resistanceScale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 20
        },
        "overrides": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/edgeOverride"
          }
        }
      },
      "description": "The operating point of a solve: common fan speed, a global resistance multiplier and per-branch overrides keyed by edge id."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "name",
        "description",
        "provenance",
        "nodes",
        "edges"
      ],
      "properties": {
        "schema": {
          "const": "aerovia.network/v1"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 240,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "description": "One ventilation network. Rules the schema cannot state: ids unique within nodes and within edges, each edge joins two distinct existing nodes, at least one node has a boundary, every node reaches a boundary through open branches (tests/contracts/test_network.py)."
    }
  }
}
