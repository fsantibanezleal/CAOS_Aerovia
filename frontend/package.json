{
  "name": "aerovia-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/prepare-data.mjs",
    "dev": "vite --host 127.0.0.1 --port 5908 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "contracts:types": "node scripts/gen-contract-types.mjs",
    "contracts:check": "node scripts/gen-contract-types.mjs --check",
    "test": "vitest run",
    "build": "node scripts/gen-contract-types.mjs --check && npm run typecheck && node scripts/prepare-data.mjs && vite build",
    "postbuild": "node scripts/generate-manifest.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4908 --strictPort",
    "test:e2e": "playwright test",
    "transport": "tsx ../scripts/transport.mts",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.15.0",
    "katex": "0.16.47",
    "lucide-react": "1.43.0",
    "onnxruntime-web": "1.29.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "three": "0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "zz-typescript5": "npm:typescript@5.9.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
